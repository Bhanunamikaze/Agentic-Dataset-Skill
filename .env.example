# ai-dataset-generator — credentials template.
#
# This file is OPTIONAL. The skill works fully offline against user-provided
# material (topics, URLs, files, existing datasets). Search-API keys below
# are only consulted when `scripts/collect.py` is asked to perform web
# research and the host IDE cannot do the browsing itself.
#
# Copy this file to `.env` (in this repo root, in the directory where you
# run the scripts, or at `~/.ai-dataset-generator/.env`) and fill in only
# the values you need. `.env` is gitignored so secrets stay local.
#
# Every key is OPTIONAL. Real shell-exported env vars always win over .env.
# CLI flags (e.g. `--api-key`) always win over both.

# ---------------------------------------------------------------------------
# Search providers (scripts/collect.py)
# ---------------------------------------------------------------------------
# `collect.py` tries these providers in order: SerpAPI → Bing → Google CSE.
# The first one with a usable key wins; if none are set, `collect.py` falls
# back to host-IDE browsing or local-file inputs.

# SerpAPI — https://serpapi.com/
SERPAPI_KEY=

# Bing Web Search v7 — https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_API_KEY=

# Google Custom Search JSON API
# Get the key at https://console.cloud.google.com/ → enable "Custom Search API".
# Create a Programmable Search Engine ID at https://programmablesearchengine.google.com/.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ---------------------------------------------------------------------------
# GitHub (optional, used when collecting from GitHub repos / issues)
# ---------------------------------------------------------------------------
# Personal access token. Read-only scope is enough for dataset collection.
# `gh auth login` is an alternative — these scripts try it as a fallback.
GITHUB_TOKEN=
# GH_TOKEN=     # accepted as an alias of GITHUB_TOKEN
